{
  "format": "neo-angband/mod/manifest",
  "schemaVersion": 2,
  "data": {
    "id": "linoleum",
    "name": "Linoleum",
    "version": "1.6.0-beta.1",
    "api": ">=2.0.0 <3.0.0",
    "runtime": "in-process",
    "engine": {
      "range": ">=1.22.0",
      "because": "The tile packs use JSON tile maps, and the game must run mod API 2."
    },
    "dependencies": {
      "required": {
        "core": {
          "range": "*"
        }
      }
    },
    "capabilities": [
      "registry:tiles"
    ],
    "description": "An alternative tile engine that makes a tile set much easier to build: a folder of individual PNGs named after what they draw, instead of one sheet plus a table of pixel coordinates.\n\nEnabling it adds six rows to the Graphics screen with Angband's own tile sets converted to this format, so you can compare both engines on the same art. The game's own graphics are core content and stay untouched when this is off.\n\nUnlike a fixed sheet, it can have one symbol draw from a pool of variants, picked by map position so a seed still replays identically. Build your own pack with the converter in the main repository, or by hand; the format is plain text plus PNGs (docs/LINOLEUM.md).\n\nConverting somebody's tile set modifies their art. The Shockbolt packs ship under permission granted to Neo Angband specifically, on condition that this project does not profit, so check a set's licence before sharing a pack you built from it.",
    "author": "neostryder",
    "license": "GPL-2.0-only",
    "repository": "https://github.com/neostryder/neo-angband-mod-linoleum",
    "payload": {
      "archives": [
        "dist/neo-linoleum-mod.zip",
        "dist/neo-linoleum-original-tiles.zip",
        "dist/neo-linoleum-adam-bolt.zip",
        "dist/neo-linoleum-gervais.zip",
        "dist/neo-linoleum-nomad.zip",
        "dist/neo-linoleum-shockbolt.zip"
      ]
    },
    "shape": "tiles",
    "facets": [
      "tiles",
      "plugin"
    ],
    "fields": [
      {
        "name": "no-object-kin-fill",
        "files": [
          "object"
        ],
        "type": "boolean"
      },
      {
        "name": "no-monster-kin-fill",
        "files": [
          "monster"
        ],
        "type": "boolean"
      }
    ],
    "rules": [
      {
        "flag": "linoleum.deriveTiles",
        "title": "Draw modded content from its kin",
        "description": "A creature or item added by a mod that has no tile of its own is drawn with its nearest relative's tile, with the colour shifted. With this off, it shows as its letter.",
        "default": true,
        "requiresReload": true
      },
      {
        "flag": "linoleum.shapeTiles",
        "title": "Draw a shapechanged character as the creature",
        "description": "During a shapechange (a Druid's fox, bear, eagle, bat, warg, vampire, werewolf or Pukel-man), the map draws the closest real creature for that form instead of your usual figure, mirrored and repainted in colours picked from your class and race. Which creature it draws depends on your level. Off by default, since it replaces a picture the tile set already supplies.",
        "default": false,
        "requiresReload": true
      }
    ],
    "tilePacks": [
      {
        "grafID": 101,
        "engine": "linoleum",
        "menuname": "Original Tiles",
        "path": "sources/original-tiles",
        "tilesheet": {
          "key": "original-tiles",
          "packId": "linoleum-original-tiles",
          "displayName": "Original Tiles",
          "cacheKey": "1.6.0-beta.1",
          "image": "source/8x8.png",
          "tileMap": "source/tile-map.json",
          "resolution": 8
        }
      },
      {
        "grafID": 102,
        "engine": "linoleum",
        "menuname": "Adam Bolt's tiles",
        "path": "sources/adam-bolt",
        "tilesheet": {
          "key": "adam-bolt",
          "packId": "linoleum-adam-bolt",
          "displayName": "Adam Bolt's tiles",
          "cacheKey": "1.6.0-beta.1",
          "image": "source/16x16.png",
          "tileMap": "source/tile-map.json",
          "resolution": 16
        }
      },
      {
        "grafID": 103,
        "engine": "linoleum",
        "menuname": "David Gervais' tiles",
        "path": "sources/gervais",
        "tilesheet": {
          "key": "gervais",
          "packId": "linoleum-gervais",
          "displayName": "David Gervais' tiles",
          "cacheKey": "1.6.0-beta.1",
          "image": "source/32x32.png",
          "tileMap": "source/tile-map.json",
          "resolution": 32
        }
      },
      {
        "grafID": 104,
        "engine": "linoleum",
        "menuname": "Nomad's tiles",
        "path": "sources/nomad",
        "tilesheet": {
          "key": "nomad",
          "packId": "linoleum-nomad",
          "displayName": "Nomad's tiles",
          "cacheKey": "1.6.0-beta.1",
          "image": "source/8x16.png",
          "tileMap": "source/tile-map.json",
          "resolution": 16,
          "tileWidth": 8,
          "tileHeight": 16
        }
      },
      {
        "grafID": 105,
        "engine": "linoleum",
        "menuname": "Shockbolt Dark",
        "path": "sources/shockbolt",
        "tilesheet": {
          "key": "shockbolt-dark",
          "packId": "linoleum-shockbolt-dark",
          "displayName": "Shockbolt Dark",
          "cacheKey": "1.6.0-beta.1",
          "image": "source/64x64.png",
          "tileMap": "source/tile-map-dark.json",
          "resolution": 64,
          "overdrawRow": 27,
          "overdrawMax": 31
        }
      },
      {
        "grafID": 106,
        "engine": "linoleum",
        "menuname": "Shockbolt Light",
        "path": "sources/shockbolt",
        "tilesheet": {
          "key": "shockbolt-light",
          "packId": "linoleum-shockbolt-light",
          "displayName": "Shockbolt Light",
          "cacheKey": "1.6.0-beta.1",
          "image": "source/64x64.png",
          "tileMap": "source/tile-map-light.json",
          "resolution": 64,
          "overdrawRow": 27,
          "overdrawMax": 31
        }
      }
    ],
    "affectsGameplay": false
  }
}
